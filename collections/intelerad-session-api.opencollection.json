{
  "opencollection": "1.0.0",
  "info": {
    "name": "InteleShare / Ambra v3 Services API (Modeled) HL7 Session API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "sid",
      "value": "{{sid}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Session",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Authenticate and obtain a session id (sid)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://access.dicomgrid.com/api/v3/session/login"
          },
          "docs": "Authenticate and obtain a session id (sid)"
        },
        {
          "info": {
            "name": "Invalidate the current session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://access.dicomgrid.com/api/v3/session/logout"
          },
          "docs": "Invalidate the current session"
        }
      ]
    }
  ],
  "bundled": true
}